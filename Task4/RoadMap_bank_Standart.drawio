        <mxCell id="IkIYEYzY61rrIkSXKF3l-16" value="&lt;span style=&quot;text-align: left;&quot;&gt;&lt;font&gt;Заявка с сайта создается в CRM-системе кол-центра.&lt;/font&gt;&lt;/span&gt;" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=5;rounded=0;" vertex="1" parent="1">
